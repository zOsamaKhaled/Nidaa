{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nidaa",
  "version": "1.1.0",
  "identifier": "com.zosamakhaled.nidaa",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nidaa",
        "width": 900,
        "height": 820,
        "minWidth": 420,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$RESOURCE/audio/**", "$RESOURCE/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["audio/*"],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English", "Arabic"]
      }
    },
    "longDescription": "Islamic prayer times with automatic Adhan playback, reminders, multilingual (Arabic/English) UI, and system tray support.",
    "shortDescription": "Prayer times & Adhan notifications"
  },
  "plugins": {}
}
